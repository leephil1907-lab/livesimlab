# LiveSim Lab server-side connection configuration
# Keep all provider credentials server-side. Never commit real values.

LIVESIM_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
LIVESIM_PUBLIC_ORIGIN=https://your-domain.example

LIVESIM_GOOGLE_CLIENT_ID=
LIVESIM_GOOGLE_CLIENT_SECRET=
LIVESIM_GOOGLE_REDIRECT_URI=https://your-domain.example/api/oauth/callback?provider=google
LIVESIM_GOOGLE_SCOPES=openid email profile

LIVESIM_ZOOM_CLIENT_ID=
LIVESIM_ZOOM_CLIENT_SECRET=
LIVESIM_ZOOM_REDIRECT_URI=https://your-domain.example/api/oauth/callback?provider=zoom
LIVESIM_ZOOM_SCOPES=user:read

LIVESIM_TIKTOK_CLIENT_KEY=
LIVESIM_TIKTOK_CLIENT_SECRET=
LIVESIM_TIKTOK_REDIRECT_URI=https://your-domain.example/api/oauth/callback?provider=tiktok
LIVESIM_TIKTOK_SCOPES=user.info.basic
