# ─────────────────────────────────────────────────────────────
#  Reachmark FaceHub configuration
#  Copy to .env (or run `npm run setup`) and fill in what you need.
#  Brand, prices, models and sample characters live in config/site.json
# ─────────────────────────────────────────────────────────────

# Public URL of the site (used for Paystack callbacks). Leave blank locally.
PUBLIC_URL=
PORT=8080
# NODE_ENV=production

# Long random string. Leave blank and one is generated and saved in data/ automatically.
SESSION_SECRET=

# Comma-separated admin emails. If blank, the FIRST account created becomes admin.
ADMIN_EMAILS=

# Free credits given to every new account (0 = none).
SIGNUP_BONUS_CREDITS=0

# ── Payments (Paystack) ──────────────────────────────────────
# Get keys at https://dashboard.paystack.com/#/settings/developers
# Webhook URL to set in Paystack: https://YOUR-DOMAIN/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# For local testing only: credit purchases instantly without charging. Never enable in production.
DEMO_PAYMENTS=false

# ── Live engine (GPU worker) ─────────────────────────────────
# URL of the GPU worker from /worker (e.g. http://gpu-box:8787 or https://worker.example.com)
GPU_WORKER_URL=
# Shared secret; must match WORKER_TOKEN on the worker.
GPU_WORKER_TOKEN=
# No GPU yet? TEST_ENGINE=true passes frames through unchanged so you can test the full flow.
TEST_ENGINE=false

# ── Links & support ──────────────────────────────────────────
# Optional download link for a Windows app build. Blank = "coming soon".
WINDOWS_APP_URL=
# Optional: your own recorded demo (MP4/WebM, e.g. /demo/demo.mp4 in public/ or a CDN link).
# Shown in the home page window frame instead of the illustration.
DEMO_VIDEO_URL=
# WhatsApp number in international format, digits only (e.g. 2348012345678)
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
