# LiveSim desktop GPU worker
LIVE_GPU_PROVIDER=cuda
LIVE_RENDERER_BACKEND=deep-live-cam
LIVE_EXECUTION_THREADS=4
LIVE_MOUTH_MASK=0
LIVESIM_GPU_CORS=http://localhost:5173,https://livesimlab.vercel.app
LIVESIM_GPU_WORKER_HOST=127.0.0.1
LIVESIM_GPU_WORKER_PORT=8787

# Only set these if you deliberately expose the worker through HTTPS/WSS.
# LIVESIM_GPU_WORKER_TOKEN=replace-with-a-long-random-token